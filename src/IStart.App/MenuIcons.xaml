<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BitmapImage x:Key="ScissorsIcon" UriSource="Assets/Icons/scissors.png"/>
  <BitmapImage x:Key="SettingsIcon" UriSource="Assets/Icons/settings.png"/>
  <BitmapImage x:Key="PlusIcon" UriSource="Assets/Icons/plus.png"/>
  <BitmapImage x:Key="ListIcon" UriSource="Assets/Icons/list.png"/>
  <BitmapImage x:Key="GridIcon" UriSource="Assets/Icons/grid-2x2.png"/>
  <BitmapImage x:Key="HistoryIcon" UriSource="Assets/Icons/history.png"/>
  <BitmapImage x:Key="UserIcon" UriSource="Assets/Icons/user-round.png"/>
  <BitmapImage x:Key="PowerIcon" UriSource="Assets/Icons/power.png"/>
  <BitmapImage x:Key="ExitIcon" UriSource="Assets/Icons/door-open.png"/>
  <BitmapImage x:Key="RemoveIcon" UriSource="Assets/Icons/x.png"/>
  <BitmapImage x:Key="SearchIcon" UriSource="Assets/Icons/search.png"/>
  <DataTemplate x:Key="ActionIconTemplate">
    <Rectangle Width="20" Height="20" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
      <Rectangle.OpacityMask><ImageBrush ImageSource="{Binding}" Stretch="Uniform"/></Rectangle.OpacityMask>
    </Rectangle>
  </DataTemplate>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="{DynamicResource ActionSize}"/><Setter Property="Height" Value="{DynamicResource ActionSize}"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="ContentTemplate" Value="{StaticResource ActionIconTemplate}"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ActionRadius}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AddIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Background" Value="{DynamicResource AddActionSurface}"/><Setter Property="Foreground" Value="{DynamicResource AddActionText}"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="NavigationItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="HorizontalContentAlignment" Value="{DynamicResource NavigationAlignment}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource NavigationRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border><Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" CornerRadius="1" Visibility="Collapsed"/></Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NavigationSelection}"/><Setter TargetName="Underline" Property="Visibility" Value="{DynamicResource WindowsBrandVisibility}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
