<Window x:Class="IStart.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IStart"
        Title="iStart · 个人开始菜单" Width="740" Height="660" MinWidth="620" MinHeight="540" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:ShellIconConverter x:Key="ShellIcon"/>
    <ItemsPanelTemplate x:Key="IconPanel"><WrapPanel/></ItemsPanelTemplate>
    <DataTemplate x:Key="EntryTile"><StackPanel Width="78" Height="68" ToolTip="{Binding Target}"><Image Source="{Binding Target, Converter={StaticResource ShellIcon}}" Width="28" Height="28" Margin="0,4,0,6"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid Margin="16" Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Accent}" CornerRadius="{DynamicResource BrandRadius}" Width="32" Height="32" Margin="0,0,9,0"><Grid><Path Data="M0,0 H8 V8 H0 Z M10,0 H18 V8 H10 Z M0,10 H8 V18 H0 Z M10,10 H18 V18 H10 Z" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{DynamicResource WindowsBrandVisibility}"/><TextBlock Visibility="{DynamicResource GoogleBrandVisibility}" Text="i" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="iStart" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <Grid Grid.Column="1" Margin="8,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="搜索软件、文件或文件夹" AutomationProperties.Name="搜索软件和收藏" Padding="36,12,12,12" BorderThickness="0"/><Path Data="M 12,3 A 9,9 0 1 1 11.99,3 M 19,19 L 26,26" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="搜索软件、文件或文件夹" Foreground="{DynamicResource TextMuted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Grid.Column="2" Content="设置" Background="Transparent" Click="OpenSettings" AutomationProperties.Name="设置"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,12,0">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBox x:Name="CategoryName" Height="36" ToolTip="新分类名称" AutomationProperties.Name="新分类名称"/>
          <Button Content="＋ 新建分类" Click="AddCategory"/>
        </StackPanel>
        <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryChanged" AllowDrop="True" Drop="CategoryDrop" DragOver="CategoryDragOver" PreviewMouseLeftButtonDown="CategoryMouseDown" PreviewMouseMove="CategoryMouseMove" DisplayMemberPath="Name" ContextMenuOpening="CategoryContextMenu" AutomationProperties.Name="分类">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,9"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
        </ListBox>
      </DockPanel>
      <Border Grid.Column="1" Background="{DynamicResource ContentSurface}" CornerRadius="{DynamicResource CardRadius}" BorderBrush="{DynamicResource CardOutline}" BorderThickness="1" Padding="14"><DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <DockPanel><Button x:Name="RecommendationToggle" Content="关闭推荐" DockPanel.Dock="Right" Click="ToggleRecommendations"/><TextBlock x:Name="RecommendationTitle" Text="软件推荐" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <TextBlock x:Name="RecommendationStatus" Text="仅在本机整理软件入口，可关闭。未读取历史使用记录。" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="Recommendations" Margin="0,5,0,8"/></ScrollViewer>
          <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ViewToggle" Content="图标" Click="ToggleView"/><Button Content="＋ 文件" Style="{StaticResource PrimaryButton}" Click="AddFile"/><Button Content="＋ 文件夹" Click="AddFolder"/></StackPanel><TextBlock x:Name="SectionTitle" Text="我的收藏" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <TextBlock Text="拖入文件、文件夹或软件快捷方式；拖动圆点调整顺序" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,9" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><ListBox x:Name="EntryList" BorderThickness="0" Background="{DynamicResource ContentSurface}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="EntryDrop" DragOver="EntryDragOver" DragLeave="EntryDragLeave" PreviewMouseLeftButtonDown="EntryMouseLeftButtonDown" PreviewMouseMove="EntryMouseMove" MouseDoubleClick="OpenSelected" KeyDown="EntryKeyDown" ContextMenuOpening="EntryContextMenu" AutomationProperties.Name="收藏入口">
          <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="5,7"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="⠿" Foreground="{DynamicResource TextMuted}" Cursor="SizeAll" VerticalAlignment="Center"/>
                <Image Grid.Column="1" Source="{Binding Target, Converter={StaticResource ShellIcon}}" Width="24" Height="24" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Target}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="3" Content="移除" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="8,5" Tag="{Binding Id}" Click="RemoveEntry" ToolTip="仅移除入口，不删除文件"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource StatusRadius}" Padding="10" Margin="0,10,0,6"><DockPanel><Button x:Name="UndoButton" Content="撤销移除" Visibility="Collapsed" DockPanel.Dock="Right" Click="UndoRemove"/><TextBlock x:Name="StatusText" Text="拖入即可添加入口，原文件保持原位。双击或按 Enter 打开。" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="账户 ▾" Click="AccountMenu"/><Button Content="Windows 原生菜单" Click="OpenNative"/></StackPanel><TextBlock x:Name="ModeStatus" Grid.Column="1" Text="原生菜单模式" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="电源 ▾" Click="PowerMenu"/><Button Content="退出" Click="Exit"/></StackPanel></Grid>
  </Grid>
</Window>
