<Window x:Class="IStart.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IStart"
        Title="iStart · 个人开始菜单" Icon="Assets/Brand/istart.ico" Width="740" Height="660" MinWidth="620" MinHeight="540" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource MenuFont}" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:ShellIconConverter x:Key="ShellIcon"/><local:CategoryIconConverter x:Key="CategoryIcon"/>
    <ItemsPanelTemplate x:Key="IconPanel"><WrapPanel/></ItemsPanelTemplate>
    <DataTemplate x:Key="EntryTile"><StackPanel Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}" ToolTip="{Binding Target}"><Image Source="{Binding Target, Converter={StaticResource ShellIcon}}" Width="28" Height="28" Margin="0,4,0,6"/><TextBlock Text="{Binding Title}" FontSize="{DynamicResource TileFontSize}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid Margin="{DynamicResource WindowPadding}" Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Brand/istart.png" Width="36" Height="36" Margin="-2,0,7,0" AutomationProperties.Name="iStart"/><TextBlock Text="iStart" FontSize="{DynamicResource BrandTitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <Grid Grid.Column="1" Margin="8,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="搜索软件、文件、文件夹或网站" AutomationProperties.Name="搜索当前列表" Padding="{DynamicResource SearchPadding}" BorderThickness="{DynamicResource SearchBorder}"/><Path Data="M 12,3 A 9,9 0 1 1 11.99,3 M 19,19 L 26,26" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{DynamicResource GoogleBrandVisibility}"/><Image Source="Assets/Fluent/search.png" Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{DynamicResource WindowsBrandVisibility}"/><TextBlock Text="搜索软件、文件、文件夹或网站" Foreground="{DynamicResource TextMuted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="ScreenshotButton" Content="截屏" Click="StartScreenshot" ToolTip="隐藏菜单后拖选范围，支持彩色标注" AutomationProperties.Name="截屏"/><Button Content="设置" Background="{DynamicResource SettingsSurface}" Click="OpenSettings" AutomationProperties.Name="设置"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,12,0">
        <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryChanged" AutomationProperties.Name="导航">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,9"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Converter={StaticResource CategoryIcon}}" Width="18" Height="18" Margin="0,0,9,0" Visibility="{DynamicResource WindowsBrandVisibility}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>

        </ListBox>
      </DockPanel>
      <Border Grid.Column="1" Background="{DynamicResource ContentSurface}" CornerRadius="{DynamicResource CardRadius}" BorderBrush="{DynamicResource CardOutline}" BorderThickness="1" Padding="{DynamicResource ContentPadding}"><DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ActivitySortButton" Content="常用网站 · 切换最近" Visibility="Collapsed" Click="ToggleActivitySort"/><Button x:Name="ViewToggle" Content="图标" Click="ToggleView"/><Button x:Name="AddFileButton" Content="＋ 软件" Style="{StaticResource PrimaryButton}" Click="AddFile"/><Button x:Name="AddFolderButton" Content="＋ 文件夹" Click="AddFolder"/></StackPanel><TextBlock x:Name="SectionTitle" Text="我的软件" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>

        </StackPanel>

        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/><Grid><ListBox x:Name="EntryList" BorderThickness="0" Background="{DynamicResource ContentSurface}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="EntryDrop" DragOver="EntryDragOver" MouseDoubleClick="OpenSelected" KeyDown="EntryKeyDown" ContextMenuOpening="EntryContextMenu" AutomationProperties.Name="收藏入口">

          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="5,7"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Target, Converter={StaticResource ShellIcon}}" Width="24" Height="24" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Target}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="2" Content="移除" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="8,5" Tag="{Binding Id}" Click="RemoveEntry" ToolTip="仅移除此处显示，不卸载软件或删除文件"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer x:Name="ComputerScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ComputerPanel"/></ScrollViewer></Grid>
      </DockPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource StatusSurface}" CornerRadius="{DynamicResource StatusRadius}" Padding="{DynamicResource StatusPadding}" Margin="0,10,0,6"><DockPanel><Button x:Name="UndoButton" Content="撤销移除" Visibility="Collapsed" DockPanel.Dock="Right" Click="UndoRemove"/><TextBlock x:Name="StatusText" FontSize="{DynamicResource StatusFontSize}" Text="拖入即可添加入口，原文件保持原位。双击或按 Enter 打开。" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Click="AccountMenu" MinWidth="{DynamicResource AccountMinWidth}"><StackPanel Orientation="Horizontal"><Image Source="Assets/Fluent/account.png" Width="22" Height="22" Margin="0,0,6,0" Visibility="{DynamicResource WindowsBrandVisibility}"/><TextBlock Text="账户 ▾" VerticalAlignment="Center"/></StackPanel></Button><Button Content="Windows 原生菜单" Click="OpenNative"/></StackPanel><TextBlock x:Name="ModeStatus" Grid.Column="1" Text="原生菜单模式" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="电源 ▾" Click="PowerMenu"/><Button Content="退出" Click="Exit"/></StackPanel></Grid>
  </Grid>
</Window>
