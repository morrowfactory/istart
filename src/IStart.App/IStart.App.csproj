<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/istart.ico</ApplicationIcon>
    <Version>0.2.0-preview.18</Version>
    <!-- WPF 主程序通过清单控制 DPI；WinForms 仅提供托盘组件。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/Fluent/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Brand/*.png;Assets/Brand/*.ico" /></ItemGroup>
</Project>
