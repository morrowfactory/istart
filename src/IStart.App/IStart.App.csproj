<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>IStart.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/istart.ico</ApplicationIcon>
    <Version>0.2.0-preview.30</Version>
    <!-- 英文来自框架中性资源；仅附带当前支持的简体中文语言资源。 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- WPF 主程序通过清单控制 DPI；WinForms 提供显示器信息与睡眠能力。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/Fluent/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Brand/*.png;Assets/Brand/*.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Icons/*.png" /></ItemGroup>
  <ItemGroup><None Update="Assets/Icons/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ThirdParty/Lucide-LICENSE.txt" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Strings.en.json" LogicalName="IStart.Strings.en.json" WithCulture="false" /></ItemGroup>
</Project>
